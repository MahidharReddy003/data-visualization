          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Times New Roman' fontsize='20'>BED OCCUPANCY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Hospital_Master+ (Healthcare_Analytics_Complete_Dataset (1))' name='federated.16xx0np0qw94o70zmeury12rbv3t' />
          </datasources>
          <datasource-dependencies datasource='federated.16xx0np0qw94o70zmeury12rbv3t'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column aggregation='CountD' caption='Admission ID' datatype='string' default-role='measure' default-type='quantitative' name='[Admission_ID]' role='dimension' type='nominal' />
            <column caption='bed occupancy' datatype='real' default-format='p0.00%' name='[Calculation_0247702510010368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Admission_ID]) / (SUM([Total_Beds])*(DATEDIFF(&apos;day&apos;,MIN([Admission_Date]),MAX([Discharge_Date]))/365))' />
            </column>
            <column caption='Discharge Date' datatype='datetime' name='[Discharge_Date]' role='dimension' type='ordinal' />
            <column caption='Total Beds' datatype='integer' name='[Total_Beds]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0247702510010368]' derivation='User' name='[usr:Calculation_0247702510010368:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
